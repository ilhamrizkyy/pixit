# Pixit environment variables. Copy this file to .env.local and fill it in.
#
# Nothing here may ever be prefixed NEXT_PUBLIC_. That prefix is what tells
# Next to inline a value into the client bundle, where every visitor reads it,
# so a gate flag carrying one would publish its own state.

# Opens the owner-only composer at /create (CLAUDE.md rule 1).
#
# The gate is CLOSED unless this is exactly `true` (case and surrounding space
# are ignored). Unset, empty, `false`, `0` and anything else 404s the route.
# That default is what keeps every deployment safe, PREVIEW builds included —
# their URLs are public, so a flag that defaulted open would ship a publicly
# reachable composer the moment a branch was pushed.
#
# Set it in your local .env.local only.
#
# ON CLOUDFLARE, "unset" IS NOT ENOUGH ON ITS OWN. The OpenNext adapter bakes
# .env values into the bundle at build time, and deploys run from your machine
# where .env.local says `true` — so a Worker with no variable set falls through
# to the baked value and serves /create. `npm run deploy` goes through
# scripts/build-cloudflare.mjs, which forces this shut in the bundle and then
# verifies it. See docs/TECH-STACK.md.
#
# To use the composer on a deployed Worker, set it as a Worker variable.
PIXLE_COMPOSER_ENABLED=false

# ---------------------------------------------------------------------------
# Supabase (Postgres). Icons published from the composer live here; the repo's
# seed icons stay in src/registry/icons.ts and the gallery merges the two.
#
# ALL THREE ARE SERVER-ONLY — no NEXT_PUBLIC_ prefix, so none reaches a browser.
# Leaving them unset is a SUPPORTED state: the app builds, tests and runs on the
# seeded icons alone. An MIT icon set has to work without somebody's database.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The anon key. Reads only — row level security limits it to published icons.
# Safe to set on the deployed Worker.
SUPABASE_PUBLISHABLE_KEY=

# The service-role key. BYPASSES ROW LEVEL SECURITY ENTIRELY.
#
# It is here because `npm run db:seed` needs it, and it must never leave this
# machine: the Cloudflare build bakes .env files into the bundle, so
# scripts/build-cloudflare.mjs strips this key and refuses to finish a build
# that still carries it. Never set it as a Worker variable.
SUPABASE_SECRET_KEY=
